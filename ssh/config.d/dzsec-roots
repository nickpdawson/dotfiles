# PROD/DEV docker LXCs (10.15.20.x, 10.15.25.x) authenticate root@ with the
# "DZsec Roots" 1P key. Pin it so the agent offers ONLY that key — without
# IdentitiesOnly the agent cycles other keys and burns MaxAuthTries (the
# crosscut/bigsky root@ symptom). Same pattern as dzsec-bench.
# Matches when connecting by IP (ssh root@10.15.20.10); add aliases if you use them.
Match user root host 10.15.20.*,10.15.25.*,10.15.42.*
    IdentitiesOnly yes
    IdentityFile ~/.ssh/dzsec_roots.pub

# Hetzner/cloud root@ — vail (pfSense), lapland (PVE host), europe 10.55.x.
# Authorizes "DZsec Hosted Roots", which sits last in agent.toml; the pin makes
# order irrelevant. dzsec_roots.pub listed second as fallback (2 offers max).
Match user root host vail.os.dzsec.net,lapland.os.dzsec.net,10.55.*
    IdentitiesOnly yes
    IdentityFile ~/.ssh/dzsec_hosted_roots.pub
    IdentityFile ~/.ssh/dzsec_roots.pub

# taos — audiobooks LXC (CT 112, PERSONAL, US egress). Libation + Audiobookshelf.
Host taos taos.dzsec.net
    HostName 10.15.42.30
    User root
    IdentitiesOnly yes
    IdentityFile ~/.ssh/dzsec_roots.pub

# corbet — stepzero agent CT (225, DEV). Name resolves the trap that
# corbet.dev.dzsec.net's A-record points at whistler/NPM: HostName pins the
# real CT IP for both spellings.
Host corbet corbet.dev.dzsec.net
    HostName 10.15.25.30
    User root
    IdentitiesOnly yes
    IdentityFile ~/.ssh/dzsec_roots.pub
