#!/bin/sh
# Keep ~/.ssh/agent.sock pointing at a live forwarded agent. Shells and
# long-running processes (old tmux sessions, Claude Code) pin SSH_AUTH_SOCK to
# it. Only repoint when the current target is gone: replacing a live link
# with this login's socket breaks those processes as soon as this login exits.
# -S follows the link; sshd removes a session's socket when the session ends.
if [ -n "$SSH_AUTH_SOCK" ] && [ "$SSH_AUTH_SOCK" != "$HOME/.ssh/agent.sock" ] \
    && [ ! -S "$HOME/.ssh/agent.sock" ]; then
    ln -sfn "$SSH_AUTH_SOCK" "$HOME/.ssh/agent.sock"
fi
